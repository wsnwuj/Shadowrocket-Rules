^https?:\/\/splashqqlive\.gtimg\.com\/website\/\d{6} - reject-img
^https?:\/\/wa\.gtimg\.com\/adxcdn\/ - reject
^https?:\/\/pgdt\.gtimg\.cn\/ - reject-img
^https?:\/\/btrace\.qq\.com(?:\/|$) - reject-200

