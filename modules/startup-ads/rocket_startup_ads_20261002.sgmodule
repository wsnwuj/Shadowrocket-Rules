[Script]
京东_启动及浮层净化 = type=http-response,requires-body=1,max-size=-1,pattern=^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(start|deliverLayer|welcomeHome)(?:&|$),script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/5d5f63fcf98bc69d5f8f1b1bae6f86a01ee4bb97/Scripts/jingdong/jingdong.js,timeout=20

什么值得买_广告分发去广告 = type=http-response,requires-body=1,max-size=-1,pattern=^https?:\/\/.*\.zdmimg\.com\/cpm\/api\/v\d\/advert_distribution\/get_all_advertise,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/314f61060a4c72c8a8b9f6b2ff457c8d35abbdac/smzdm_json.js,timeout=20

菜鸟_amdc = type=http-response,requires-body=1,max-size=-1,pattern=^http:\/\/amdc\.m\.taobao\.com,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/314f61060a4c72c8a8b9f6b2ff457c8d35abbdac/amdc.js,timeout=20
菜鸟_响应去推广 = type=http-response,requires-body=1,max-size=-1,pattern=^https?:\/\/(?:[a-zA-Z0-9_.-]+\.cainiao\.com|(?:acs|guide-acs|acs4miniapp-inner)\.m\.taobao\.com)\/gw\/mtop\.cainiao\.(app\.e2e\.engine\.page\.fetch|nbpresentation\.homepage\.merge\.get\.cn|nbpresentation\.protocol\.homepage\.get\.cn|adkeyword),script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/314f61060a4c72c8a8b9f6b2ff457c8d35abbdac/cainiao_json.js,timeout=20

铁路12306_开屏去广告 = type=http-response,requires-body=1,max-size=-1,pattern=^https?:\/\/ad\.12306\.cn\/ad\/ser\/getAdList(?:\?.*)?$,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/314f61060a4c72c8a8b9f6b2ff457c8d35abbdac/12306.js,timeout=20

航旅纵横Pro_开屏去广告 = type=http-response,requires-body=1,max-size=-1,pattern=^https?:\/\/(114\.115\.217\.129|home\.umetrip\.com)\/gateway\/api\/umetrip\/native(?:\?.*)?$,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/5d5f63fcf98bc69d5f8f1b1bae6f86a01ee4bb97/Scripts/umetrip/umetrip_ads.js,timeout=20

爱奇艺_开屏去广告 = type=http-response,requires-body=1,max-size=-1,pattern=^https?:\/\/[\w.-]+\.cupid\.iqiyi\.com\/mixer\?,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/314f61060a4c72c8a8b9f6b2ff457c8d35abbdac/iqiyi_open_ads.js,timeout=20

百度贴吧_JSON去广告 = type=http-response,requires-body=1,max-size=-1,pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/(c\/(s\/sync|f\/(ad\/getSplashAd|frs\/(page|threadlist|generalTabList)|pb\/(pic)?page|excellent\/personalized))$|tiebaads\/commonbatch\?),script-path=https://raw.githubusercontent.com/app2smile/rules/df6366a7024e0b3f0aa3510c5b791eea6f3cba89/js/tieba-json.js,timeout=20
百度贴吧_PROTO去广告 = type=http-response,requires-body=1,binary-body-mode=1,max-size=-1,pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/c\/(b\/ad\/adBid|f\/(frs\/(page|threadlist|generalTabList)|ad\/getFeedAd|pb\/page|excellent\/personalized))\?cmd,script-path=https://raw.githubusercontent.com/app2smile/rules/df6366a7024e0b3f0aa3510c5b791eea6f3cba89/js/tieba-proto.js,timeout=20

微博_开屏响应去广告 = type=http-response,requires-body=1,max-size=-1,pattern=^https?:\/\/(boot.*weibo\.com\/v\d\/ad\/(preload|realtime)|(sdkapp|wbapp)\.uve\.weibo\.com\/),script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/314f61060a4c72c8a8b9f6b2ff457c8d35abbdac/weibo_json.js,timeout=20

哔哩哔哩_开屏去广告 = type=http-response,requires-body=1,max-size=-1,pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/splash\/(brand\/list|event\/list2?|list|show)(?:\?|$),script-path=https://raw.githubusercontent.com/Walvez/surge-startup-ads/d50d33cbd187f68778d8ca0b977c09f12cc23983/scripts/bilibili-splash-ads.js,timeout=20

淘宝_开屏 = type=http-response,requires-body=1,max-size=-1,pattern=^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(cloudvideo\.video\.query|wireless\.home\.splash\.awesome\.get),script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/5d5f63fcf98bc69d5f8f1b1bae6f86a01ee4bb97/Scripts/myBlockAds.js,timeout=20
淘宝_活动弹层 = type=http-response,requires-body=1,max-size=-1,pattern=^https:\/\/poplayer\.template\.alibaba\.com\/\w+\.json,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/5d5f63fcf98bc69d5f8f1b1bae6f86a01ee4bb97/Scripts/myBlockAds.js,timeout=20

