[URL Rewrite]
# ===== 京东 =====
# 仅广告专用接口返回空字典；start/deliverLayer/welcomeHome 用响应脚本保留业务字段
^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(homeAreaPop|home_launchConfig|lite_advertising|queryMaterialAdverts|smart_delivery_strategy)(?:&|$) - reject-dict

# ===== 什么值得买 =====
^https?:\/\/api\.smzdm\.com\/v\d+\/util\/loading(?:\?.*)?$ - reject-dict
^https?:\/\/s\d+\.zdmimg\.com\/www\/api\/v\d+\/api\/thirdAd\.php - reject

# ===== 菜鸟 =====
^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(show|mshow)\.cn(?:\/|\?).* - reject-200
^https?:\/\/(?:[a-zA-Z0-9_.-]+\.cainiao\.com|(?:acs|guide-acs|acs4miniapp-inner)\.m\.taobao\.com)\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?!.*_home) - reject-200
^https?:\/\/(?:[a-zA-Z0-9_.-]+\.cainiao\.com|(?:acs|guide-acs|acs4miniapp-inner)\.m\.taobao\.com)\/gw\/mtop\.cainiao\.nbcps\.presentation\.fetch\.cn - reject-200
^https?:\/\/(?:[a-zA-Z0-9_.-]+\.cainiao\.com|(?:acs|guide-acs|acs4miniapp-inner)\.m\.taobao\.com)\/gw\/mtop\.cainiao\.app\.home\.v\d+\.bottom\.area - reject-200
^https?:\/\/longquan-mtop\.cainiao\.com\/gw\/mtop\.com\.cainiao\.longquan\.place\.getpageresourcecontent\.cn - reject-200

# ===== 铁路12306 =====
^https?:\/\/ad\.12306\.cn\/ad\/mon\/mzc(?:\?.*)?$ - reject

# ===== 航旅纵横 Pro =====
# 未采用 oss.umetrip.com/fs/advert/polite：公开维护源注明可能误杀首页横幅
