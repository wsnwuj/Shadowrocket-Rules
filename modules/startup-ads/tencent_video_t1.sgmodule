#!name=腾讯视频 T2.2.1 · 汽车广告分片与自检修正
#!desc=配合R7；保持T2.2的两段已确认汽车素材匹配范围。自检兼容HTTP/HTTPS并提供直接验证链接。自检https://omex.tc.qq.com/__sr_t2_check；开屏效果及正片播放仍需实测。
#!homepage=https://github.com/wsnwuj/Shadowrocket-Rules

# Two observed CDN hosts; two visually confirmed creative identities only.
# Generic path prefixes below do not contain captured signatures or device/query values.
# info4/info6 source: https://github.com/fmz200/wool_scripts/blob/main/Loon/rule/TencentVideo.list

[General]
force-http-engine-hosts = %APPEND% omex.tc.qq.com,ltsyz.gtimg.com

[Rule]
DOMAIN,info4.video.qq.com,REJECT
DOMAIN,info6.video.qq.com,REJECT

[Script]
Tencent_T2_2_1_Creative_Check = type=http-request,pattern=^https?:\/\/(?:(?:omex\.tc\.qq\.com|ltsyz\.gtimg\.com)(?::(?:80|443))?\/(?:[^/?#]+\/)*(?:\d+_)?gzc_1000127_(?:0b53umccyaae6iaf3n46tzvnfi6dfsraik2a|0b53bybvuaadxiahgz4wqfvnkdwdlihqgxka)\.f\d+(?:\.\d+)?\.(?:mp4|ts)(?:\?[^#]*)?$|omex\.tc\.qq\.com(?::(?:80|443))?\/__sr_t2_(?:check|status)(?:\?[^#]*)?$),script-path=https://raw.githubusercontent.com/wsnwuj/Shadowrocket-Rules/e8eb230c2121da861bed101f16ff6733a8e27467/modules/startup-ads/tencent-creative-t2-2-1.js,timeout=10

[MITM]
hostname = %APPEND% omex.tc.qq.com,ltsyz.gtimg.com
