#!name=腾讯视频 T3.3 · 接口格式补充诊断
#!desc=配合R7及T2.2.1；只观察三个域名的固定接口，补充JSONP/XML/表单及字节正文识别。打开https://omex.tc.qq.com/__sr_t3_check，开始记录后启动腾讯视频一次，控件消失后停止并复制JSON报告，最后关闭此模块。
#!homepage=https://github.com/wsnwuj/Shadowrocket-Rules

# Temporary opt-in observer; no ad-block rules and no script-side network calls.
# Raw bodies, parameter values, arbitrary keys, headers and signed media URLs are never saved.
# Recording expires in three minutes; disable this module to remove its MITM settings.

[General]
force-http-engine-hosts = %APPEND% omex.tc.qq.com

[Script]
Tencent_T3_3_Request_Observer = type=http-request,requires-body=1,max-size=1048576,pattern=^https?:\/\/(?:(?:vv6?\.video\.qq\.com(?::(?:80|443))?\/(?:getvinfo|batchvinfo)|v\.qq\.com(?::(?:80|443))?\/cache\/wuji_public\/object)|(?:vv6?\.video\.qq\.com|v\.qq\.com)(?::(?:80|443))?\/__sr_t3_probe|omex\.tc\.qq\.com(?::(?:80|443))?\/__sr_t3_(?:check|status|reset|stop))(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/wsnwuj/Shadowrocket-Rules/5ea68fb572e8b55a7ac8a7ed7c5cec7b2d0a5a26/modules/startup-ads/tencent-diagnostic-t3-3.js,timeout=10
Tencent_T3_3_Response_Observer = type=http-response,requires-body=1,binary-body-mode=1,max-size=1048576,pattern=^https?:\/\/(?:vv6?\.video\.qq\.com(?::(?:80|443))?\/(?:getvinfo|batchvinfo)|v\.qq\.com(?::(?:80|443))?\/cache\/wuji_public\/object)(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/wsnwuj/Shadowrocket-Rules/5ea68fb572e8b55a7ac8a7ed7c5cec7b2d0a5a26/modules/startup-ads/tencent-diagnostic-t3-3.js,timeout=10

[MITM]
hostname = %APPEND% vv.video.qq.com,vv6.video.qq.com,v.qq.com,omex.tc.qq.com
