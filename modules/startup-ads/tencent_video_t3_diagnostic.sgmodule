#!name=腾讯视频 T3 · 开屏网页临时诊断
#!desc=与R7及T2.1同时使用；普通请求和响应保持原样。先打开http://omex.tc.qq.com/__sr_t3_check，点击开始记录，再启动腾讯视频一次。仅本地保存3分钟内的脱敏接口类型、字段类型和次数；不保存参数值或原文。
#!homepage=https://github.com/wsnwuj/Shadowrocket-Rules

# This is an opt-in observer, not a verified new ad-removal rule.
# Five exact TCP HTTPS hosts from the latest local test; no wildcard MITM or QUIC changes.
# Keep R7 and T2.1 enabled. Remove/disable this temporary module after collecting a report.

[General]
force-http-engine-hosts = %APPEND% omex.tc.qq.com,mcgi.v.qq.com

[Script]
Tencent_T3_Request_Observer = type=http-request,pattern=^https?:\/\/(?:(?:v\.qq\.com|m\.v\.qq\.com|vfiles\.gtimg\.cn|mcgi\.v\.qq\.com|rdelivery\.qq\.com)(?::(?:80|443))?\/|omex\.tc\.qq\.com(?::(?:80|443))?\/__sr_t3_(?:check|status|reset)(?:\?[^#]*)?$),script-path=https://raw.githubusercontent.com/wsnwuj/Shadowrocket-Rules/28347656e901410902834843f086dd525adc5e47/modules/startup-ads/tencent-diagnostic-t3.js,timeout=10
Tencent_T3_Response_Observer = type=http-response,requires-body=1,max-size=1048576,pattern=^https?:\/\/(?:(?:m\.)?v\.qq\.com(?::(?:80|443))?\/(?![^?#]*\.(?:mp4|ts|m3u8|png|jpe?g|gif|webp|avif|woff2?|ttf|zip|js|css)(?:\?|$))|vfiles\.gtimg\.cn(?::(?:80|443))?\/[^?#]*\.(?:html?|json|config|config_list|txt)(?:\?|$)|mcgi\.v\.qq\.com(?::(?:80|443))?\/commdatav2(?:\?|$)|rdelivery\.qq\.com(?::(?:80|443))?\/v[123]\/(?:config|sdkconfig)\/(?:pull|batchpull|get)(?:\?|$)),script-path=https://raw.githubusercontent.com/wsnwuj/Shadowrocket-Rules/28347656e901410902834843f086dd525adc5e47/modules/startup-ads/tencent-diagnostic-t3.js,timeout=10

[MITM]
hostname = %APPEND% v.qq.com,m.v.qq.com,vfiles.gtimg.cn,mcgi.v.qq.com,rdelivery.qq.com
